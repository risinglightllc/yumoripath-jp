<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title data-en="Subscribe — Yumori Path" data-ja="サブスクリプション登録 — 湯守道">サブスクリプション登録 — 湯守道</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png">
  <style>
    .plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:32px 0}
    .plan-card{border:1.5px solid var(--color-stone-light);border-radius:var(--radius-md);padding:28px 24px;text-align:center;cursor:pointer;transition:border-color .15s}
    .plan-card:hover, .plan-card.selected{border-color:var(--color-indigo)}
    .plan-card input{display:none}
    .plan-card .price{font-family:var(--font-serif);font-size:1.8rem;color:var(--color-indigo);margin:8px 0}
    .plan-card .period{font-size:0.75rem;color:var(--color-text-light)}
    .plan-card.best .badge{display:inline-block;background:var(--color-gold);color:#fff;font-size:0.68rem;padding:2px 10px;border-radius:10px;margin-bottom:8px}
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <div class="navbar-brand">
        <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
          <span class="navbar-brand-jp" data-en="Yumori Path">湯守道</span>
          <span class="navbar-brand-en" data-en="Restoration. Respect. Renewal.">YUMORI PATH</span>
        </a>
      </div>
      <ul class="navbar-nav">
        <li>
          <button class="lang-toggle" id="langToggle" aria-label="Toggle language">
            <span class="lang-jp">JP</span><span class="lang-sep">/</span><span class="lang-en">EN</span>
          </button>
        </li>
      </ul>
    </div>
  </nav>
  <main style="padding-top:64px;">
    <section class="form-section">
      <div class="container">
        <div class="form-card" style="max-width:600px;">
          <p class="overline" style="color:var(--color-gold);" data-en="Property Search" data-ja="物件検索">物件検索</p>
          <h2 data-en="Search the Full Property Map" data-ja="物件マップを検索する">物件マップを検索する</h2>
          <p class="form-sub" data-en="Subscribe to search and browse Japan's stigmatized-property map. Cancel anytime." data-ja="サブスクリプションに登録すると、日本全国の事故物件マップを検索・閲覧できます。いつでも解約できます。">サブスクリプションに登録すると、日本全国の事故物件マップを検索・閲覧できます。いつでも解約できます。</p>
          <% if (typeof error !== 'undefined' && error) { %><div class="err" style="background:#fee2e2;color:#991b1b;padding:10px 14px;border-radius:6px;margin-bottom:16px;font-size:13px;"><%= error %></div><% } %>
          <form method="POST" action="/subscribe">
            <div class="plan-grid">
              <label class="plan-card selected" id="planMonthlyCard">
                <input type="radio" name="plan" value="monthly" checked>
                <div data-en="Monthly" data-ja="月額プラン">月額プラン</div>
                <div class="price">$9</div>
                <div class="period" data-en="per month" data-ja="月々">月々</div>
              </label>
              <label class="plan-card best" id="planAnnualCard">
                <span class="badge" data-en="Best Value" data-ja="お得">お得</span><br>
                <input type="radio" name="plan" value="annual">
                <div data-en="Annual" data-ja="年間プラン">年間プラン</div>
                <div class="price">$110</div>
                <div class="period" data-en="per year" data-ja="年間">年間</div>
              </label>
            </div>
            <div class="form-actions" style="justify-content:stretch;">
              <button type="submit" class="btn-submit" style="width:100%;" data-en="Continue to Checkout" data-ja="お支払いへ進む">お支払いへ進む</button>
            </div>
          </form>
          <p style="text-align:center;margin-top:20px;font-size:0.78rem;color:var(--color-text-light);" data-en="Payment is securely processed by Stripe. Yumori Path never sees your card details." data-ja="お支払いはStripeにより安全に処理されます。湯守道がカード情報を直接取得することはありません。">お支払いはStripeにより安全に処理されます。湯守道がカード情報を直接取得することはありません。</p>
        </div>
      </div>
    </section>
  </main>
  <script>
    document.querySelectorAll('.plan-card').forEach(function(card){
      card.addEventListener('click', function(){
        document.querySelectorAll('.plan-card').forEach(function(c){ c.classList.remove('selected'); });
        card.classList.add('selected');
        card.querySelector('input').checked = true;
      });
    });
  </script>
  <script>
  (function() {
    var toggle = document.getElementById('langToggle');
    var isEnglish = localStorage.getItem('yumori-lang') === 'en';
    document.querySelectorAll('[data-en]').forEach(function(el) {
      if (!el.hasAttribute('data-ja')) el.setAttribute('data-ja', el.textContent.trim());
    });
    function applyLanguage(en) {
      document.documentElement.lang = en ? 'en' : 'ja';
      document.querySelectorAll('[data-en]').forEach(function(el) {
        el.textContent = en ? el.getAttribute('data-en') : el.getAttribute('data-ja');
      });
    }
    applyLanguage(isEnglish);
    if (toggle) {
      toggle.classList.toggle('active', isEnglish);
      toggle.addEventListener('click', function() {
        isEnglish = !isEnglish;
        localStorage.setItem('yumori-lang', isEnglish ? 'en' : 'ja');
        toggle.classList.toggle('active', isEnglish);
        applyLanguage(isEnglish);
      });
    }
  })();
  </script>
</body>
</html>
