  <!-- Language Toggle -->
  <script>
  (function() {
    var toggle = document.getElementById('langToggle');
    var isEnglish = localStorage.getItem('yumori-lang') === 'en';
    document.querySelectorAll('[data-en]').forEach(function(el) {
      if (!el.hasAttribute('data-ja')) el.setAttribute('data-ja', el.textContent.trim());
    });
    function applyLanguage(en) {
      document.documentElement.lang = en ? 'en' : 'ja';
      document.body.setAttribute('data-lang', en ? 'en' : 'ja');
      document.querySelectorAll('[data-en]').forEach(function(el) {
        el.textContent = en ? el.getAttribute('data-en') : el.getAttribute('data-ja');
      });
      document.querySelectorAll('[data-placeholder-en]').forEach(function(el) {
        el.placeholder = en ? el.getAttribute('data-placeholder-en') : el.getAttribute('data-placeholder-ja');
      });
    }
    applyLanguage(isEnglish);
    if (toggle) {
      toggle.classList.toggle('active', isEnglish);
      toggle.addEventListener('click', function() {
        isEnglish = !isEnglish;
        localStorage.setItem('yumori-lang', isEnglish ? 'en' : 'ja');
        toggle.classList.toggle('active', isEnglish);
        applyLanguage(isEnglish);
      });
    }
  })();
  </script>

  <script>
    document.getElementById('clergyForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      const isEn = document.body.getAttribute('data-lang') === 'en';
      btn.textContent = isEn ? 'Submitting...' : '送信中...';

      const form = e.target;
      const formData = new FormData(form);
      const body = {};
      for (const [k, v] of formData.entries()) {
        if (body[k] !== undefined) {
          if (Array.isArray(body[k])) body[k].push(v);
          else body[k] = [body[k], v];
        } else {
          body[k] = v;
        }
      }

      try {
        const res = await fetch('/clergy-form', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        if (res.ok || res.redirected) {
          form.style.display = 'none';
          document.getElementById('formSuccess').classList.add('show');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          const data = await res.json();
          alert(data.error || (isEn ? 'An error occurred. Please try again.' : 'エラーが発生しました。もう一度お試しください。'));
          btn.disabled = false;
          btn.textContent = isEn ? 'Register' : '登録する';
        }
      } catch(err) {
        alert(isEn ? 'An error occurred. Please try again.' : 'エラーが発生しました。もう一度お試しください。');
        btn.disabled = false;
        btn.textContent = isEn ? 'Register' : '登録する';
      }
    });
  </script>
</body>
