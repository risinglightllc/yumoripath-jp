  <main style="padding-top:64px;">
    <section class="form-section form-section-alt">
      <div class="container">
        <div class="form-card">
          <p class="overline" style="color:var(--color-gold);" data-en="Clergy Registration Form" data-ja="宗教者登録フォーム">宗教者登録フォーム</p>
          <h2 data-en="Register as Temple, Shrine, or Clergy" data-ja="寺社・宗教者として登録する">寺社・宗教者として登録する</h2>
          <p class="form-sub" data-en="If you are interested in contributing to your community through property restoration work, please register below. We will review your submission and contact you within 2–3 business days." data-ja="地域貢献の一つの形として、訳あり物件の再生支援にご関心をお持ちいただけましたら、以下よりご登録ください。内容を確認のうえ、担当者よりご連絡いたします。">地域貢献の一つの形として、訳あり物件の再生支援にご関心をお持ちいただけましたら、以下よりご登録ください。内容を確認のうえ、担当者よりご連絡いたします。</p>

          <!-- Form -->
          <form id="clergyForm" action="/clergy-form" method="POST" novalidate>
            <div class="form-grid">
              <div class="form-group full">
                <label data-en="Temple / Shrine / Organization Name" data-ja="寺院・神社・宗教団体名">寺院・神社・宗教団体名 <span class="req">*</span></label>
                <input type="text" name="temple_shrine_org_name" required data-placeholder-en="e.g. Soto Zen Temple ○○, Shrine ○○" data-placeholder-ja="例：○○寺、○○神社" placeholder="例：○○寺、○○神社">
              </div>
              <div class="form-group">
                <label data-en="Religious Tradition" data-ja="宗教・系統">宗教・系統 <span class="req">*</span></label>
                <select name="religious_tradition" required>
                  <option value="" data-en="Please select" data-ja="選択してください">選択してください</option>
                  <option data-en="Buddhism" data-ja="仏教">仏教</option>
                  <option data-en="Shinto" data-ja="神道">神道</option>
                  <option data-en="Christianity" data-ja="キリスト教">キリスト教</option>
                  <option data-en="Other" data-ja="その他">その他</option>
                </select>
              </div>
              <div class="form-group">
                <label data-en="Denomination / Sect" data-ja="宗派・教派等">宗派・教派等</label>
                <input type="text" name="denomination" data-placeholder-en="e.g. Soto-shu, Tendai-shu, Jinja Honcho" data-placeholder-ja="例：浄土宗、真言宗、神社本庁など" placeholder="例：浄土宗、真言宗、神社本庁など">
              </div>
              <div class="form-group">
                <label data-en="Contact Person" data-ja="ご担当者名">ご担当者名 <span class="req">*</span></label>
                <input type="text" name="contact_person" required data-placeholder-en="e.g. Makoto Sato" data-placeholder-ja="例：佐藤 誠" placeholder="例：佐藤 誠">
              </div>
              <div class="form-group">
                <label data-en="Role / Title" data-ja="ご役割">ご役割</label>
                <input type="text" name="role" data-placeholder-en="e.g. Head priest, Shinto priest, Religious counselor" data-placeholder-ja="例：住職、僧侶、神職、宗教相談員" placeholder="例：住職、僧侶、神職、宗教相談員">
              </div>
              <div class="form-group">
                <label data-en="Email Address" data-ja="メールアドレス">メールアドレス <span class="req">*</span></label>
                <input type="email" name="email" required data-placeholder-en="e.g. sato@example.temple.jp" data-placeholder-ja="例：sato@example.temple.jp" placeholder="例：sato@example.temple.jp">
              </div>
              <div class="form-group">
                <label data-en="Phone Number" data-ja="電話番号">電話番号</label>
                <input type="tel" name="phone" data-placeholder-en="e.g. 075-123-4567" data-placeholder-ja="例：075-123-4567" placeholder="例：075-123-4567">
              </div>
              <div class="form-group">
                <label data-en="Prefecture" data-ja="都道府県">都道府県 <span class="req">*</span></label>
                <select name="prefecture" required>
                  <option value="" data-en="Please select" data-ja="選択してください">選択してください</option>
                  <option>北海道</option><option>青森県</option><option>岩手県</option><option>宮城県</option><option>秋田県</option><option>山形県</option><option>福島県</option>
                  <option>茨城県</option><option>栃木県</option><option>群馬県</option><option>埼玉県</option><option>千葉県</option><option>東京都</option><option>神奈川県</option>
                  <option>新潟県</option><option>富山県</option><option>石川県</option><option>福井県</option><option>山梨県</option><option>長野県</option>
                  <option>岐阜県</option><option>静岡県</option><option>愛知県</option><option>三重県</option>
                  <option>滋賀県</option><option>京都府</option><option>大阪府</option><option>兵庫県</option><option>奈良県</option><option>和歌山県</option>
                  <option>鳥取県</option><option>島根県</option><option>岡山県</option><option>広島県</option><option>山口県</option>
                  <option>徳島県</option><option>香川県</option><option>愛媛県</option><option>高知県</option>
                  <option>福岡県</option><option>佐賀県</option><option>長崎県</option><option>熊本県</option><option>大分県</option><option>宮崎県</option><option>鹿児島県</option><option>沖縄県</option>
                </select>
              </div>
              <div class="form-group">
                <label data-en="City / District" data-ja="市区町村">市区町村</label>
                <input type="text" name="municipality" data-placeholder-en="e.g. Nakagyo-ku Kyoto, Kasuga-ku" data-placeholder-ja="例：京都市中京区、奈良市" placeholder="例：京都市中京区、奈良市">
              </div>
              <div class="form-group full">
                <label data-en="Service Area" data-ja="対応可能地域">対応可能地域</label>
                <input type="text" name="service_area" data-placeholder-en="e.g. All of Kyoto Prefecture, central Osaka area" data-placeholder-ja="例：京都府全域、大阪市中心部" placeholder="例：京都府全域、大阪市中心部">
              </div>
              <div class="form-group full">
                <label data-en="Available Ceremonies / Services" data-ja="対応可能な儀礼・ご相談内容">対応可能な儀礼・ご相談内容</label>
                <select name="services_offered" required>
                  <option value="" data-en="Please select" data-ja="選択してください">選択してください</option>
                  <option data-en="Memorial Rite (慰霊・供養)" data-ja="慰霊・供養">慰霊・供養</option>
                  <option data-en="Purification Ritual (お祓い)" data-ja="お祓い">お祓い</option>
                  <option data-en="Cleansing Rite (清祓（きよはらい）)" data-ja="清祓（きよはらい）">清祓（きよはらい）</option>
                  <option data-en="Shrine Prayer (ご祈祷)" data-ja="ご祈祷">ご祈祷</option>
                  <option data-en="On-site Visit" data-ja="現地での事前確認">現地での事前確認</option>
                  <option data-en="Memorial Service (法要)" data-ja="法要">法要</option>
                  <option data-en="Counseling" data-ja="ご相談対応">ご相談対応</option>
                  <option data-en="Other" data-ja="その他">その他</option>
                </select>
              </div>
              <div class="form-group full">
                <label data-en="Interest in Real Estate Cases" data-ja="不動産に関するご相談への対応意向">不動産に関するご相談への対応意向 <span class="req">*</span></label>
                <select name="accepts_real_estate_cases" required>
                  <option value="" data-en="Please select" data-ja="選択してください">選択してください</option>
                  <option value="yes" data-en="Available — eager to take on cases">対応可能・前向きに検討したい</option>
                  <option value="maybe" data-en="May be available in some cases">場合により対応可能</option>
                  <option value="no" data-en="Not available at this time">現在は対応が難しい</option>
                </select>
              </div>
              <div class="form-group full">
                <label data-en="Approach / Notes" data-ja="対応方針・補足事項">対応方針・補足事項</label>
                <textarea name="notes" data-placeholder-en="Your approach to ritual services, how to reach you, any other preferences or notes." data-placeholder-ja="信仰上・宗派上の対応方針、地域との関わり方、ご要望などをご記入ください。" placeholder="信仰上・宗派上の対応方針、地域との関わり方、ご要望などをご記入ください。"></textarea>
              </div>
              <div class="form-group full">
                <div class="form-check">
                  <input type="checkbox" name="consent" id="consent" required value="yes">
                  <label for="consent"><span class="req">*</span> <span data-en="I agree to the Privacy Policy and Terms of Service" data-ja="プライバシーポリシーおよび利用規約に同意します">プライバシーポリシーおよび利用規約に同意します</span></label>
                </div>
              </div>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn-submit" id="submitBtn" data-en="Register" data-ja="登録する">登録する</button>
            </div>
          </form>

          <!-- Success -->
          <div class="form-success" id="formSuccess">
            <div class="form-success-icon">✓</div>
            <h3 data-en="Registration Received" data-ja="登録を受け付けました">登録を受け付けました</h3>
            <p data-en="Thank you for registering. We will review your submission and contact you within 2–3 business days. A confirmation email will be sent to the address you provided." data-ja="ご登録ありがとうございます。内容を確認のうえ、担当者より2〜3営業日以内にご連絡いたします。確認メールは、ご入力いただいたメールアドレス宛に送信されます。">ご登録ありがとうございます。内容を確認のうえ、担当者より2〜3営業日以内にご連絡いたします。<br>確認メールは、ご入力いただいたメールアドレス宛に送信されます。</p>
            <div class="form-success-actions">
              <a href="/" class="btn-primary" style="font-size:0.85rem;" data-en="Return Home" data-ja="TOPに戻る">TOPに戻る</a>
              <a href="/clergy-form" class="btn-secondary" style="font-size:0.85rem;border-color:var(--color-indigo);color:var(--color-indigo);" data-en="Submit Another Registration" data-ja="別の内容で登録する">別の内容で登録する</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-bottom" style="border:none;padding-top:0;">
        <span>© 2026 Yumori Path.</span>
        <div class="footer-bottom-links">
