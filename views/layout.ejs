  <!-- Language Toggle -->
  <script>
  (function() {
    var toggle = document.getElementById('langToggle');
    var isEnglish = localStorage.getItem('yumori-lang') === 'en';
    // Store original Japanese text in data-ja on first run
    document.querySelectorAll('[data-en]').forEach(function(el) {
      if (!el.hasAttribute('data-ja')) el.setAttribute('data-ja', el.textContent.trim());
    });
    function applyLanguage(en) {
      document.documentElement.lang = en ? 'en' : 'ja';
      document.body.setAttribute('data-lang', en ? 'en' : 'ja');
      document.querySelectorAll('[data-en]').forEach(function(el) {
        var target = el.getAttribute('data-ja') !== null ? 'data-ja' : null;
        if (target) {
          if (el.tagName === 'META') {
            el.setAttribute('content', en ? el.getAttribute('data-en') : el.getAttribute('data-ja'));
          } else if (el.tagName === 'TITLE') {
            el.textContent = en ? el.getAttribute('data-en') : el.getAttribute('data-ja');
          } else if (el.hasAttribute('data-html') || el.hasAttribute('data-html-en')) {
            el.innerHTML = en ? el.getAttribute('data-html-en') : el.getAttribute('data-html-ja');
          } else {
            el.textContent = en ? el.getAttribute('data-en') : el.getAttribute('data-ja');
          }
        } else {
          el.textContent = en ? el.getAttribute('data-en') : el.textContent;
        }
      });
      document.querySelectorAll('[data-placeholder-en]').forEach(function(el) {
        el.placeholder = en ? el.getAttribute('data-placeholder-en') : el.getAttribute('data-placeholder-ja');
      });
    }
    applyLanguage(isEnglish);
    if (toggle) {
      toggle.classList.toggle('active', isEnglish);
      toggle.addEventListener('click', function() {
        isEnglish = !isEnglish;
        localStorage.setItem('yumori-lang', isEnglish ? 'en' : 'ja');
        toggle.classList.toggle('active', isEnglish);
        applyLanguage(isEnglish);
      });
    }
  })();
  </script>
</body>
</html>