<%- include('layout', { body: `
<div class="page-header">
  <h1>Portfolio Overview</h1>
</div>

<style>
.portfolio-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px; }
.pillar-card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
.pillar-header { padding: 20px; border-bottom: 1px solid var(--border); }
.pillar-icon { font-size: 28px; margin-bottom: 8px; }
.pillar-name { font-size: 16px; font-weight: 700; color: var(--accent-dark); }
.pillar-desc { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
.pillar-count { font-size: 12px; color: var(--text-muted); margin-top: 6px; }
.pillar-body { padding: 16px; }
.entry-item { padding: 14px 0; border-bottom: 1px solid var(--border); }
.entry-item:last-child { border-bottom: none; }
.entry-name { font-weight: 600; font-size: 14px; }
.entry-value { font-size: 13px; color: var(--accent); margin-top: 2px; }
.entry-notes { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
.entry-actions { margin-top: 8px; display: flex; gap: 8px; }
.entry-actions button { font-size: 12px; padding: 4px 10px; cursor: pointer; border: 1px solid var(--border); background: var(--panel); border-radius: 4px; }
.entry-actions button:hover { background: var(--bg); }
.add-form { padding: 16px; border-top: 1px solid var(--border); background: var(--bg); }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
.form-row.full { grid-template-columns: 1fr; }
.form-row input, .form-row textarea { width: 100%; padding: 6px 10px; border: 1px solid var(--border); border-radius: 4px; font-size: 13px; background: var(--panel); }
.form-row textarea { resize: vertical; min-height: 50px; }
.add-btn { width: 100%; padding: 8px; background: var(--accent); color: white; border: none; border-radius: 4px; font-size: 13px; font-weight: 500; cursor: pointer; }
.add-btn:hover { background: var(--accent-dark); }
.empty-pillar { padding: 24px; text-align: center; color: var(--text-muted); font-size: 13px; }
@media (max-width: 900px) { .portfolio-grid { grid-template-columns: 1fr; } }
</style>

<div class="portfolio-grid">
  ${['digital_sovereignty','generational_real_estate','yumori_path'].map(key => {
    const pillar = byPillar[key];
    const entries = pillar ? pillar.entries : [];
    return `
    <div class="pillar-card">
      <div class="pillar-header">
        <div class="pillar-icon">${key === 'digital_sovereignty' ? '◈' : key === 'generational_real_estate' ? '◉' : '◎'}</div>
        <div class="pillar-name">${pillar ? pillar.label : key.replace(/_/g, ' ').replace(/\b\/g, c => c.toUpperCase())}</div>
        <div class="pillar-desc">${pillar ? (pillar.description || '') : ''}</div>
        <div class="pillar-count">${entries.length} item${entries.length !== 1 ? 's' : ''}</div>
      </div>
      <div class="pillar-body">
        ${entries.length === 0 ? '<div class="empty-pillar">No entries yet</div>' : entries.map(e => `
          <div class="entry-item">
            <div class="entry-name">${e.name}</div>
            ${e.value ? `<div class="entry-value">${e.value}</div>` : ''}
            ${e.description ? `<div class="entry-notes">${e.description}</div>` : ''}
            ${e.notes ? `<div class="entry-notes" style="font-style:italic">${e.notes}</div>` : ''}
            <div class="entry-actions">
              <button onclick="editEntry(${e.id}, '${e.name}', '${e.value || ''}', '${(e.description || '').replace(/'/g, "\\'")}', '${(e.notes || '').replace(/'/g, "\\'")}')">Edit</button>
              <button onclick="deleteEntry(${e.id})">Delete</button>
            </div>
          </div>
        `).join('')}
      </div>
      <div class="add-form">
        <form id="form-${key}" onsubmit="addEntry(event, '${key}')">
          <div class="form-row"><input type="text" name="name" placeholder="Asset name (e.g. Ledger XRP Wallet)" required></div>
          <div class="form-row"><input type="text" name="value" placeholder="Value (e.g. 12,500 XRP)"></div>
          <div class="form-row full"><textarea name="description" placeholder="Brief description"></textarea></div>
          <div class="form-row full"><textarea name="notes" placeholder="Notes / memo"></textarea></div>
          <button type="submit" class="add-btn">+ Add Entry</button>
        </form>
      </div>
    </div>
    `;
  }).join('')}
</div>

<script>
async function addEntry(e, pillarKey) {
  e.preventDefault();
  const form = e.target;
  const data = { pillar_key: pillarKey, name: form.name.value, value: form.value.value, description: form.description.value, notes: form.notes.value };
  const res = await fetch('/admin/portfolio/entries', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
  if (res.ok) location.reload(); else alert('Failed to add entry');
}

async function deleteEntry(id) {
  if (!confirm('Delete this entry?')) return;
  const res = await fetch('/admin/portfolio/entries/' + id, { method: 'DELETE' });
  if (res.ok) location.reload(); else alert('Failed to delete');
}

function editEntry(id, name, value, description, notes) {
  const newName = prompt('Name:', name);
  if (!newName) return;
  const newValue = prompt('Value:', value);
  const newDesc = prompt('Description:', description);
  const newNotes = prompt('Notes:', notes);
  fetch('/admin/portfolio/entries/' + id, {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ name: newName, value: newValue, description: newDesc, notes: newNotes })
  }).then(r => r.ok && location.reload());
}
</script>
` }) %>