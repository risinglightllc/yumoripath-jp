<%- include('../../admin_partials/header', { currentPath: '/admin/finance', pageTitle: 'New Payment' }) %>
<div class="topbar"><h1>New Payment Record</h1><a href="/admin/finance" class="btn btn-secondary">← Back</a></div>
<% if (typeof error !== 'undefined' && error) { %><div class="err"><%= error %></div><% } %>
<div class="card">
  <form method="POST" action="/admin/finance">
    <div class="two-col">
      <div class="form-group"><label>Client Name</label><input type="text" name="client_name" required></div>
      <div class="form-group"><label>Related Case ID (optional)</label><input type="number" name="case_id" placeholder="Leave blank if standalone"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Fee Type</label><input type="text" name="fee_type" placeholder="e.g. 祓い料金, 慰霊, コンサル"></div>
      <div class="form-group"><label>Quoted Amount (JPY)</label><input type="number" name="quoted_amount" step="1" placeholder="e.g. 50000"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Payment Status</label><select name="payment_status"><% PAYMENT_STATUSES.forEach(s => { %><option value="<%= s %>" <%= s === 'quoted' ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
      <div class="form-group"><label>Payment Date</label><input type="date" name="payment_date"></div>
    </div>
    <div class="form-group"><label>Invoice Link (placeholder)</label><input type="url" name="invoice_link" placeholder="https://..."></div>
    <div class="form-group"><label>Notes</label><textarea name="notes" placeholder="Any notes about this payment..."></textarea></div>
    <div class="actions"><button type="submit" class="btn btn-primary">Create Record</button></div>
  </form>
</div>
<%- include('../../admin_partials/footer') %>
