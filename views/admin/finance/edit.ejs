<%- include('../admin_partials/header', { currentPath: '/admin/finance', pageTitle: 'Edit Payment' }) %>
<div class="topbar"><h1>Edit Payment #<%= p.id %></h1><a href="/admin/finance/<%= p.id %>" class="btn btn-secondary">← Back</a></div>
<% if (typeof error \!== 'undefined' && error) { %><div class="err"><%= error %></div><% } %>
<div class="card">
  <form method="POST" action="/admin/finance/<%= p.id %>">
    <div class="two-col">
      <div class="form-group"><label>Client Name</label><input type="text" name="client_name" value="<%= p.client_name || '' %>" required></div>
      <div class="form-group"><label>Case ID</label><input type="number" name="case_id" value="<%= p.case_id || '' %>"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Fee Type</label><input type="text" name="fee_type" value="<%= p.fee_type || '' %>"></div>
      <div class="form-group"><label>Quoted Amount (JPY)</label><input type="number" name="quoted_amount" step="1" value="<%= p.quoted_amount || '' %>"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Payment Status</label><select name="payment_status"><% PAYMENT_STATUSES.forEach(s => { %><option value="<%= s %>" <%= p.payment_status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
      <div class="form-group"><label>Payment Date</label><input type="date" name="payment_date" value="<%= p.payment_date || '' %>"></div>
    </div>
    <div class="form-group"><label>Notes</label><textarea name="notes"><%= p.notes || '' %></textarea></div>
    <div class="actions"><button type="submit" class="btn btn-primary">Save Changes</button></div>
  </form>
</div>
<%- include('../admin_partials/footer') %>
