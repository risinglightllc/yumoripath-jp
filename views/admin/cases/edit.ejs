<%- include('../../admin_partials/header', { currentPath: '/admin/cases', pageTitle: 'Edit Case #' + c.case_id }) %>
<div class="topbar"><h1>Edit Case #<%= c.case_id %></h1><a href="/admin/cases/<%= c.case_id %>" class="btn btn-secondary">← Back</a></div>
<% if (typeof error !== 'undefined' && error) { %><div class="err"><%= error %></div><% } %>
<div class="card">
  <form method="POST" action="/admin/cases/<%= c.case_id %>">
    <div class="four-col">
      <div class="form-group"><label>Company Name</label><input type="text" name="company_name" value="<%= c.company_name || '' %>"></div>
      <div class="form-group"><label>Contact Person</label><input type="text" name="contact_person" value="<%= c.contact_person || '' %>"></div>
      <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= c.email || '' %>"></div>
      <div class="form-group"><label>Phone</label><input type="text" name="phone" value="<%= c.phone || '' %>"></div>
    </div>
    <div class="three-col">
      <div class="form-group"><label>Prefecture</label><input type="text" name="prefecture" value="<%= c.prefecture || '' %>"></div>
      <div class="form-group"><label>Municipality</label><input type="text" name="municipality" value="<%= c.municipality || '' %>"></div>
      <div class="form-group"><label>Property Type</label><input type="text" name="property_type" value="<%= c.property_type || '' %>"></div>
    </div>
    <div class="three-col">
      <div class="form-group"><label>Relationship to Property</label><input type="text" name="relationship_to_property" value="<%= c.relationship_to_property || '' %>"></div>
      <div class="form-group"><label>Desired Service</label><input type="text" name="desired_service" value="<%= c.desired_service || '' %>"></div>
      <div class="form-group"><label>Timeline</label><input type="text" name="timeline" value="<%= c.timeline || '' %>"></div>
    </div>
    <div class="three-col">
      <div class="form-group"><label>Concern Category</label><input type="text" name="concern_category" value="<%= c.concern_category || '' %>"></div>
      <div class="form-group"><label>Sensitivity Level</label><select name="sensitivity_level"><option value="">—</option><% ['low','medium','high'].forEach(l => { %><option value="<%= l %>" <%= c.sensitivity_level === l ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
      <div class="form-group"><label>Status</label><select name="status"><% STATUSES.forEach(s => { %><option value="<%= s %>" <%= c.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
    </div>
    <div class="form-group"><label>Notes</label><textarea name="notes"><%= c.notes || '' %></textarea></div>
    <div class="actions"><button type="submit" class="btn btn-primary">Save Changes</button></div>
  </form>
</div>
<%- include('../../admin_partials/footer') %>
