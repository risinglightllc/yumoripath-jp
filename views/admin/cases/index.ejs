<%- include('../admin_partials/header', { currentPath: '/admin/cases', pageTitle: 'Case Pipeline' }) %>

<div class="topbar">
  <h1>Case Pipeline</h1>
  <a href="/admin/cases/new" class="btn btn-primary">+ New Case</a>
</div>

<div class="card">
  <div class="card-title">Filters</div>
  <form class="filter-bar" method="GET" action="/admin/cases">
    <select name="status">
      <option value="">All Statuses</option>
      <% STATUSES.forEach(s => { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <input type="text" name="prefecture" placeholder="Prefecture" value="<%= filters.prefecture || '' %>">
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a href="/admin/cases" class="btn btn-secondary">Clear</a>
  </form>
</div>

<div class="card">
  <div class="card-title">Status Breakdown</div>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px">
    <% statusCounts.forEach(r => { %>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:10px 14px;display:flex;align-items:center;gap:8px">
        <span class="badge <%= r.status === 'New submission' ? 'badge-new' : r.status === 'Needs review' ? 'badge-review' : r.status === 'Priest/clergy matching' ? 'badge-matching' : r.status === 'Ceremony scheduled' ? 'badge-scheduled' : r.status === 'Completed' ? 'badge-completed' : 'badge-muted' %>"><%= r.status %></span>
        <strong><%= r.count %></strong>
      </div>
    <% }) %>
  </div>
</div>

<div class="card">
  <% if (cases.length === 0) { %>
    <div class="empty">No cases found — <a href="/admin/cases/new">add one</a></div>
  <% } else { %>
  <table>
    <thead><tr><th>ID</th><th>Company</th><th>Prefecture</th><th>Service</th><th>Status</th><th>Submitted</th><th></th></tr></thead>
    <tbody>
      <% cases.forEach(c => { %>
        <tr>
          <td>#<%= c.case_id %></td>
          <td><strong><%= c.company_name || '—' %></strong><br><span style="font-size:11px;color:var(--muted)"><%= c.contact_person || '—' %></span></td>
          <td><%= c.prefecture || '—' %></td>
          <td><%= c.desired_service || '—' %></td>
          <td><span class="badge <%= c.status === 'New submission' ? 'badge-new' : c.status === 'Needs review' ? 'badge-review' : c.status === 'Priest/clergy matching' ? 'badge-matching' : c.status === 'Ceremony scheduled' ? 'badge-scheduled' : c.status === 'Completed' ? 'badge-completed' : 'badge-muted' %>"><%= c.status %></span></td>
          <td><%= c.submission_date ? new Date(c.submission_date).toLocaleDateString('ja-JP') : '—' %></td>
          <td><a href="/admin/cases/<%= c.case_id %>">View →</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<%- include('../admin_partials/footer') %>
