<%- include('../../admin_partials/header', { currentPath: '/admin/outreach', pageTitle: 'Log Outreach' }) %>
<div class="topbar"><h1>Log Outreach</h1><a href="/admin/outreach" class="btn btn-secondary">← Back</a></div>
<% if (typeof error !== 'undefined' && error) { %><div class="err"><%= error %></div><% } %>
<div class="card">
  <form method="POST" action="/admin/outreach">
    <div class="two-col">
      <div class="form-group"><label>Recipient Name</label><input type="text" name="recipient" required></div>
      <div class="form-group"><label>Recipient Type</label><select name="recipient_type" required><option value="">Select type...</option><option value="real_estate">Real Estate Firm</option><option value="clergy">Clergy Partner</option><option value="vendor">Restoration Vendor</option></select></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Date Sent</label><input type="date" name="date_sent" value="<%= new Date().toISOString().split('T')[0] %>"></div>
      <div class="form-group"><label>Prefecture</label><input type="text" name="prefecture" placeholder="例: 東京都"></div>
    </div>
    <div class="form-group"><label>Template Used</label><input type="text" name="template_used" placeholder="e.g. initial_outreach_v1"></div>
    <div class="two-col">
      <div class="form-group"><label>Response Status</label><select name="response_status"><% RESPONSE_STATUSES.forEach(s => { %><option value="<%= s %>" <%= s === 'no response' ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
      <div class="form-group"><label>Next Follow-up Date</label><input type="date" name="next_follow_up_date"></div>
    </div>
    <div class="form-group"><label>Notes</label><textarea name="notes" placeholder="What was the outreach about? Any context..."></textarea></div>
    <div class="actions"><button type="submit" class="btn btn-primary">Log Outreach</button></div>
  </form>
</div>
<%- include('../../admin_partials/footer') %>
