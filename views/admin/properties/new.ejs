<%- include('../../admin_partials/header', { currentPath: '/admin/properties', pageTitle: 'New Property' }) %>
<div class="topbar"><h1>New Property</h1><a href="/admin/properties" class="btn btn-secondary">← Back</a></div>
<% if (typeof error !== 'undefined' && error) { %><div class="err"><%= error %></div><% } %>
<div class="card">
  <form method="POST" action="/admin/properties">
    <div class="form-group"><label>Address</label><input type="text" name="address" required placeholder="例: 東京都新宿区西新宿2-8-1"></div>
    <div class="three-col">
      <div class="form-group"><label>Prefecture</label><input type="text" name="prefecture" placeholder="例: 東京都"></div>
      <div class="form-group"><label>City</label><input type="text" name="city"></div>
      <div class="form-group"><label>Severity (1–5)</label><input type="number" name="severity" min="1" max="5" value="1"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Latitude</label><input type="text" name="latitude" placeholder="e.g. 35.6895"></div>
      <div class="form-group"><label>Longitude</label><input type="text" name="longitude" placeholder="e.g. 139.6917"></div>
    </div>
    <div class="two-col">
      <div class="form-group">
        <label>Incident Type</label>
        <select name="incident_type" required>
          <% INCIDENT_TYPES.forEach(t => { %><option value="<%= t.value %>"><%= t.ja %> (<%= t.en %>)</option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>Incident Date</label><input type="date" name="incident_date"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Description (JA)</label><textarea name="description_ja"></textarea></div>
      <div class="form-group"><label>Description (EN)</label><textarea name="description_en"></textarea></div>
    </div>
    <div class="form-group"><label>Source</label><input type="text" name="source" placeholder="Where this was reported/verified from"></div>
    <div class="form-group">
      <label><input type="checkbox" name="verified" style="width:auto;display:inline-block;margin-right:6px;"> Verified (shows on public lookup + map)</label>
    </div>
    <div class="actions"><button type="submit" class="btn btn-primary">Create Property</button></div>
  </form>
</div>
<%- include('../../admin_partials/footer') %>
