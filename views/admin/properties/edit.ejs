<%- include('../../admin_partials/header', { currentPath: '/admin/properties', pageTitle: 'Edit Property' }) %>
<div class="topbar"><h1>Edit Property #<%= p.id %></h1><a href="/admin/properties" class="btn btn-secondary">← Back</a></div>
<% if (typeof error !== 'undefined' && error) { %><div class="err"><%= error %></div><% } %>
<div class="card">
  <form method="POST" action="/admin/properties/<%= p.id %>">
    <div class="form-group"><label>Address</label><input type="text" name="address" required value="<%= p.address %>"></div>
    <div class="three-col">
      <div class="form-group"><label>Prefecture</label><input type="text" name="prefecture" value="<%= p.prefecture || '' %>"></div>
      <div class="form-group"><label>City</label><input type="text" name="city" value="<%= p.city || '' %>"></div>
      <div class="form-group"><label>Severity (1–5)</label><input type="number" name="severity" min="1" max="5" value="<%= p.severity || 1 %>"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Latitude</label><input type="text" name="latitude" value="<%= p.latitude || '' %>"></div>
      <div class="form-group"><label>Longitude</label><input type="text" name="longitude" value="<%= p.longitude || '' %>"></div>
    </div>
    <div class="two-col">
      <div class="form-group">
        <label>Incident Type</label>
        <select name="incident_type" required>
          <% INCIDENT_TYPES.forEach(t => { %><option value="<%= t.value %>" <%= p.incident_type === t.value ? 'selected' : '' %>><%= t.ja %> (<%= t.en %>)</option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>Incident Date</label><input type="date" name="incident_date" value="<%= p.incident_date ? new Date(p.incident_date).toISOString().slice(0,10) : '' %>"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Description (JA)</label><textarea name="description_ja"><%= p.description_ja || '' %></textarea></div>
      <div class="form-group"><label>Description (EN)</label><textarea name="description_en"><%= p.description_en || '' %></textarea></div>
    </div>
    <div class="form-group"><label>Source</label><input type="text" name="source" value="<%= p.source || '' %>"></div>
    <div class="form-group">
      <label><input type="checkbox" name="verified" style="width:auto;display:inline-block;margin-right:6px;" <%= p.verified ? 'checked' : '' %>> Verified (shows on public lookup + map)</label>
    </div>
    <div class="actions"><button type="submit" class="btn btn-primary">Save Changes</button></div>
  </form>
</div>
<%- include('../../admin_partials/footer') %>
