<%- include('../admin_partials/header', { currentPath: '/admin/clergy', pageTitle: 'Edit Partner' }) %>
<div class="topbar"><h1>Edit Partner</h1><a href="/admin/clergy/<%= c.id %>" class="btn btn-secondary">← Back</a></div>
<% if (typeof error \!== 'undefined' && error) { %><div class="err"><%= error %></div><% } %>
<div class="card">
  <form method="POST" action="/admin/clergy/<%= c.id %>">
    <div class="two-col">
      <div class="form-group"><label>Temple/Shrine/Organization</label><input type="text" name="temple_shrine_org_name" value="<%= c.temple_shrine_org_name || '' %>" required></div>
      <div class="form-group"><label>Religious Tradition</label><select name="religious_tradition"><option value="Buddhist" <%= c.religious_tradition === 'Buddhist' ? 'selected' : '' %>>Buddhist</option><option value="Shinto" <%= c.religious_tradition === 'Shinto' ? 'selected' : '' %>>Shinto</option><option value="Other" <%= c.religious_tradition === 'Other' ? 'selected' : '' %>>Other</option></select></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Contact Person</label><input type="text" name="contact_person" value="<%= c.contact_person || '' %>"></div>
      <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= c.email || '' %>"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Phone</label><input type="text" name="phone" value="<%= c.phone || '' %>"></div>
      <div class="form-group"><label>Denomination</label><input type="text" name="denomination" value="<%= c.denomination || '' %>"></div>
    </div>
    <div class="two-col">
      <div class="form-group"><label>Prefecture</label><input type="text" name="prefecture" value="<%= c.prefecture || '' %>"></div>
      <div class="form-group"><label>Municipality</label><input type="text" name="municipality" value="<%= c.municipality || '' %>"></div>
    </div>
    <div class="form-group"><label>Services Offered</label><input type="text" name="services_offered" value="<%= c.services_offered || '' %>"></div>
    <div class="two-col">
      <div class="form-group"><label>Accepts Real Estate Cases</label><select name="accepts_real_estate_cases"><option value="false" <%= \!c.accepts_real_estate_cases ? 'selected' : '' %>>No</option><option value="true" <%= c.accepts_real_estate_cases ? 'selected' : '' %>>Yes</option></select></div>
      <div class="form-group"><label>Registration Status</label><select name="registration_status"><option value="pending" <%= c.registration_status === 'pending' ? 'selected' : '' %>>Pending</option><option value="approved" <%= c.registration_status === 'approved' ? 'selected' : '' %>>Approved</option><option value="active" <%= c.registration_status === 'active' ? 'selected' : '' %>>Active</option></select></div>
    </div>
    <div class="form-group"><label>Notes</label><textarea name="notes"><%= c.notes || '' %></textarea></div>
    <div class="actions"><button type="submit" class="btn btn-primary">Save Changes</button></div>
  </form>
</div>
<%- include('../admin_partials/footer') %>
