  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500&family=Noto+Serif+JP:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/static/favicon/favicon-192x192.png">
  <link rel="apple-touch-icon" href="/static/favicon/apple-touch-icon.png">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <div class="navbar-brand">
        <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
          <span class="navbar-brand-jp" data-en="Yumori Path" data-ja="湯守道">湯守道</span>
          <span class="navbar-brand-en" data-en="Restoration. Respect. Renewal." data-ja="YUMORI PATH">YUMORI PATH</span>
        </a>
      </div>
      <ul class="navbar-nav" style="gap:16px;">
        <li><a href="/" data-en="Home" data-ja="ホーム">ホーム</a></li>
        <li>
          <button class="lang-toggle" id="langToggle" aria-label="Toggle language">
            <span class="lang-jp">JP</span><span class="lang-sep">/</span><span class="lang-en">EN</span>
          </button>
        </li>
      </ul>
    </div>
  </nav>
  <main style="padding-top:64px;">
    <section class="form-section form-section-alt">
      <div class="container" style="max-width:760px;">
        <div class="form-card">
          <h2 style="color:var(--color-indigo);font-size:1.6rem;margin-bottom:32px;" data-en="Privacy Policy" data-ja="プライバシーポリシー">プライバシーポリシー</h2>
          <div style="font-size:0.875rem;line-height:1.9;color:var(--color-text-mid);">
            <p style="margin-bottom:20px;" data-en="Yumori Path respects the privacy of all users and handles personal information with care and integrity." data-ja="本サイト（湯守道）は、利用者のプライバシーを尊重し、個人情報を適切に保護します。">本サイト（湯守道）は、利用者のプライバシーを尊重し、個人情報を適切に保護します。</p>
            <h4 style="color:var(--color-indigo);margin:24px 0 8px;font-size:0.9rem;" data-en="1. Information We Collect" data-ja="1. 収集する情報">1. 収集する情報</h4>
            <p style="margin-bottom:16px;" data-en="We collect your name, company name, email address, property details, and other information submitted through our inquiry forms." data-ja="問い合わせフォームより氏名・会社名・メールアドレス・物件情報等を収集します。">問い合わせフォームより氏名・会社名・メールアドレス・物件情報等を収集します。</p>
            <h4 style="color:var(--color-indigo);margin:24px 0 8px;font-size:0.9rem;" data-en="2. Purpose of Use" data-ja="2. 利用目的">2. 利用目的</h4>
            <p style="margin-bottom:16px;" data-en="Collected information is used solely for inquiry response and communication with clergy partners. We do not disclose information to third parties." data-ja="収集した情報は相談対応、宗教者との調整連絡のみに使用し、第三者に開示しません。">収集した情報は相談対応、宗教者との調整連絡のみに使用し、第三者に開示しません。</p>
            <h4 style="color:var(--color-indigo);margin:24px 0 8px;font-size:0.9rem;" data-en="3. Data Protection" data-ja="3. 情報の管理">3. 情報の管理</h4>
            <p style="margin-bottom:16px;" data-en="We protect your data through strict access controls and encrypted storage of sensitive information." data-ja="適切なアクセス管理と機密情報の暗号化保存によりデータを保護します。">適切なアクセス管理と機密情報の暗号化保存によりデータを保護します。</p>
            <h4 style="color:var(--color-indigo);margin:24px 0 8px;font-size:0.9rem;" data-en="4. Cookies" data-ja="4. Cookieの使用">4. Cookieの使用</h4>
            <p style="margin-bottom:16px;" data-en="This service may use cookies for access analytics. No personally identifiable information is included." data-ja="本サービスでは、アクセス解析のためにCookieを使用する場合があります。Cookieには、個人を特定する情報は含まれません。">本サービスでは、アクセス解析のためにCookieを使用する場合があります。Cookieには、個人を特定する情報は含まれません。</p>
            <h4 style="color:var(--color-indigo);margin:24px 0 8px;font-size:0.9rem;" data-en="5. Contact" data-ja="5. お問い合わせ">5. お問い合わせ</h4>
            <p data-en="For privacy-related questions, please contact us at: admin@risinglightllc.com" data-ja="プライバシーに関するご質問は admin@risinglightllc.com までお願いします。">プライバシーに関するご質問は admin@risinglightllc.com までお願いします。</p>
          </div>
          <div style="margin-top:40px;">
            <a href="/" class="btn-primary" style="display:inline-flex;font-size:0.85rem;" data-en="Return Home" data-ja="TOPに戻る">TOPに戻る</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer class="footer">
    <div class="container">
      <div class="footer-bottom" style="border:none;padding-top:0;">
        <span>© 2026 Yumori Path.</span>
        <div class="footer-bottom-links">
          <a href="/privacy">プライバシーポリシー</a>
          <a href="/terms">利用規約</a>
        </div>
      </div>
    </div>
  </footer>
<script>
  (function() {
    var toggle = document.getElementById('langToggle');
    var isEnglish = localStorage.getItem('yumori-lang') === 'en';
    document.querySelectorAll('[data-en]').forEach(function(el) {
      if (!el.hasAttribute('data-ja')) el.setAttribute('data-ja', el.textContent.trim());
    });
    function applyLanguage(en) {
      document.documentElement.lang = en ? 'en' : 'ja';
      document.body.setAttribute('data-lang', en ? 'en' : 'ja');
      document.querySelectorAll('[data-en]').forEach(function(el) {
        el.textContent = en ? el.getAttribute('data-en') : el.getAttribute('data-ja');
      });
    }
    applyLanguage(isEnglish);
    if (toggle) {
      toggle.classList.toggle('active', isEnglish);
      toggle.addEventListener('click', function() {
        isEnglish = !isEnglish;
        localStorage.setItem('yumori-lang', isEnglish ? 'en' : 'ja');
        toggle.classList.toggle('active', isEnglish);
        applyLanguage(isEnglish);
      });
    }
  })();
</script>
</body>
</html>